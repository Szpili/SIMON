[Unit]
Description=SIMON node 2 (Franko: RTX 3080 Ti, Ollama, Bielik 11B)
Documentation=https://github.com/Szpili/SIMON
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --key-file, NIE --key: systemd rozwija ${ZMIENNA} do argv, wiec ziarno
# byloby widoczne w `ps` dla kazdego uzytkownika maszyny (sprawdzone).
#
# Backend jest na INNEJ MASZYNIE (przez Tailscale). Wezel zna wtedy mniej
# o sobie: Ollama nie wystawia /tokenize ani max_model_len, wiec bramka
# kontekstu jest wylaczona i node to WYPISUJE przy starcie.
ExecStart=%h/SIMON/target/release/simon --role node \
    --listen /ip4/127.0.0.1/tcp/9402 \
    --model-url http://<node-windows>:11434 \
    --model-hash SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M \
    --key-file %h/.simon/node2.key
Restart=always
RestartSec=10
StandardOutput=append:%h/.simon/node2.log
StandardError=append:%h/.simon/node2.log

[Install]
WantedBy=default.target
